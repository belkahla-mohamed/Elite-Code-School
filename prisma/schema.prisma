generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgramLevel {
  debutant
  intermediaire
  avance

  @@map("program_level")
}

enum PriceType {
  monthly
  hourly

  @@map("price_type")
}

enum RequestStatus {
  pending
  accepted
  refused

  @@map("request_status")
}

enum ProjectStatus {
  completed
  in_progress

  @@map("project_status")
}

model Category {
  id          String    @id
  name        String
  slug        String    @unique
  description String    @default("")
  color       String    @default("sky")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  programs    Program[]

  @@map("categories")
}

model Program {
  id           String       @id
  title        String
  ageRange     String?      @map("age_range")
  level        ProgramLevel
  description  String
  tools        String[]
  toolsDescription String  @default("") @map("tools_description")
  galleryImages String[]   @default([]) @map("gallery_images")
  certificatePreview String @default("") @map("certificate_preview")
  priceMonthly Int?         @map("price_monthly")
  priceType    PriceType    @default(monthly) @map("price_type")
  totalHours   Int?         @map("total_hours")
  durationMonths Int?       @map("duration_months")
  color        String       @default("accent")
  image        String       @default("")
  duration     String       @default("")
  objectives   String       @default("")
  prerequisites String      @default("")
  schedule     String       @default("")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")

  categoryId   String?      @map("category_id")
  category     Category?    @relation(fields: [categoryId], references: [id])

  students          Student[]
  inscriptionRequests InscriptionRequest[]

  @@map("programs")
}

model InscriptionRequest {
  id               String        @id @default(cuid())
  studentFirstName String        @map("student_first_name")
  studentLastName  String        @map("student_last_name")
  age              Int
  schoolLevel      String?       @map("school_level")
  programId        String        @map("program_id")
  program          Program       @relation(fields: [programId], references: [id])
  parentFirstName  String        @default("") @map("parent_first_name")
  parentLastName   String        @default("") @map("parent_last_name")
  parentPhone      String        @map("parent_phone")
  parentEmail      String        @map("parent_email")
  message          String?
  adminNotes       String?       @map("admin_notes")
  rejectionMessage String?       @map("rejection_message")
  status           RequestStatus @default(pending)
  createdAt        DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("inscription_requests")
}

model Student {
  id               String   @id @default(cuid())
  slug             String   @unique
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  age              Int
  avatar           String
  avatarGradient   String   @default("linear-gradient(135deg,#4f46e5,#06b6d4)") @map("avatar_gradient")
  programId        String   @map("program_id")
  program          Program  @relation(fields: [programId], references: [id])
  levelLabel       String   @map("level_label")
  joinDateLabel    String   @map("join_date_label")
  hours            Int      @default(0)
  isPublic         Boolean  @default(true) @map("is_public")
  parentEmail      String   @map("parent_email")
  parentSecretHash String   @map("parent_secret_hash")
  parentFirstName  String   @default("") @map("parent_first_name")
  parentLastName   String   @default("") @map("parent_last_name")
  createdAt        DateTime @default(now()) @map("created_at")

  projects       Project[]
  certifications Certification[]
  galleryItems   GalleryItem[]
  parents        Parent[] @ignore

  @@index([slug])
  @@index([isPublic])
  @@map("students")
}

model Project {
  id          String        @id @default(cuid())
  studentId   String        @map("student_id")
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  tags        String[]
  status      ProjectStatus @default(in_progress)
  progress    Int           @default(0)
  dateLabel   String        @map("date_label")
  emoji       String        @default("💼")
  gradient    String        @default("linear-gradient(135deg,#4f46e5,#818cf8)")
  coverImage  String?       @map("cover_image")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([studentId])
  @@map("projects")
}

model Certification {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  mention    String   @default("Validé")
  dateLabel  String   @map("date_label")
  emoji      String   @default("🏅")
  gradient   String   @default("linear-gradient(135deg,#f59e0b,#f97316)")
  imageUrl   String?  @map("image_url")
  serialCode String   @unique @default(cuid()) @map("serial_code")
  issueDate  DateTime @default(now()) @map("issue_date")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("certifications")
}

model GalleryItem {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label      String
  emoji      String   @default("📸")
  gradient   String   @default("linear-gradient(135deg,#06b6d4,#0ea5e9)")
  imageUrl   String?  @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("gallery_items")
}

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         String    @default("admin")
  permissions  String[]  @default([])
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz(6)

  @@map("admin_users")
  @@ignore
}

model AppSettings {
  id                      BigInt   @id @default(1)
  autoAcceptInscriptions  Boolean  @default(false) @map("auto_accept_inscriptions")
  emailValidation         Boolean  @default(true) @map("email_validation")
  publicPortfoliosDefault Boolean  @default(true) @map("public_portfolios_default")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  emailNotifications      Boolean  @default(true) @map("email_notifications")
  sessionDurationHours    Int      @default(8) @map("session_duration_hours")
  minPasswordLength       Int      @default(6) @map("min_password_length")
  contactEmail            String   @default("contact@elitecode.ma") @map("contact_email")
  emailFrom               String   @default("Elite Code School <onboarding@resend.dev>") @map("email_from")
  adminEmail              String   @default("") @map("admin_email")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
  @@ignore
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  title       String
  description String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notifications")
  @@ignore
}

model Parent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String   @default("")
  secretHash   String   @map("secret_hash")
  passwordHash String?  @map("password_hash")
  studentId    String   @map("student_id")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("parents")
  @@ignore
}

model ParentPasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String   @map("parent_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("parent_password_resets")
  @@ignore
}

model Follow {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([studentId, targetId])
  @@index([targetId])
  @@map("follows")
}

model StudentRequest {
  id                   String        @id @default(cuid())
  studentId            String        @map("student_id")
  type                 String
  status               RequestStatus @default(pending)
  title                String
  description          String        @default("")
  hours                Int?
  certificateTitle     String?       @map("certificate_title")
  certificateMention   String?       @map("certificate_mention")
  certificateDateLabel String?       @map("certificate_date_label")
  certificateEmoji     String?       @map("certificate_emoji")
  certificateGradient  String?       @map("certificate_gradient")
  adminNotes           String?       @map("admin_notes")
  createdAt            DateTime      @default(now()) @map("created_at")
  processedAt          DateTime?     @map("processed_at")

  @@index([studentId])
  @@index([status])
  @@map("student_requests")
}

model StudentMessage {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  message   String
  reply     String?
  createdAt DateTime @default(now()) @map("created_at")
  repliedAt DateTime? @map("replied_at")

  @@index([studentId])
  @@map("student_messages")
}

model StudentAlert {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  title       String
  description String   @default("")
  emoji       String   @default("📣")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_alerts")
}

model ContentBlock {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("content_blocks")
  @@ignore
}
